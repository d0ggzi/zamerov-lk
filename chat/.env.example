# ─── Shared ────────────────────────────────────────────────────────────────────
# Must match JWT_SECRET in backend/.env — both services sign/verify the same tokens.
JWT_SECRET=changeme

# ─── Chat service ───────────────────────────────────────────────────────────────
CHAT_PORT=8090

# ─── PostgreSQL ─────────────────────────────────────────────────────────────────
# Local dev: host=localhost
# Docker Compose overrides CHAT_POSTGRES_HOST to the container name automatically.
CHAT_POSTGRES_HOST=localhost
CHAT_POSTGRES_PORT=5432
CHAT_POSTGRES_USER=chat
CHAT_POSTGRES_PASSWORD=chat
CHAT_POSTGRES_DB=chat

# ─── Integration tests ──────────────────────────────────────────────────────────
# Set this to run integration tests against a real database.
# Tests are skipped automatically when this variable is unset.
CHAT_TEST_DSN=host=localhost port=5432 user=chat password=chat dbname=chat sslmode=disable
